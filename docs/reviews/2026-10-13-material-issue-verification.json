      "column mes_material_issue id bigint NO 领料出库单本地主键",
      "column mes_material_issue factory_id varchar(64) NO 所属工厂标识，由服务端当前上下文填写",
      "column mes_material_issue issue_no varchar(64) NO MES领料出库单编号，不代表外部单据主键",
      "column mes_material_issue workorder_id bigint YES 本地生产工单主键，逻辑引用当前业务库工单",
      "column mes_material_issue workorder_code varchar(64) YES 生产工单编号快照，有本地工单时由服务端填写",
      "column mes_material_issue product_id bigint YES 产出产品主键，逻辑引用本厂物料产品资料",
      "column mes_material_issue product_code varchar(64) YES 产出品号快照，不等于明细材料品号",
      "column mes_material_issue flow_card_no varchar(128) YES 来源流程卡号，普通业务字符串，不自动生成",
      "column mes_material_issue routing_id bigint YES 执行工艺确切版本主键，引用已发布的路线版本",
      "column mes_material_issue issue_time datetime YES 领料业务发生时间，空值表示尚未提供",
      "column mes_material_issue status varchar(16) NO 资料状态，DRAFT草稿，RECORDED已记录，不表示外部审核状态",
      "column mes_material_issue remark varchar(500) YES 领料出库单备注",
      "column mes_material_issue create_by varchar(64) YES 创建人系统用户标识，由服务端填写",
      "column mes_material_issue create_time datetime YES 创建时间，由服务端填写",
      "column mes_material_issue update_by varchar(64) YES 最后修改人系统用户标识，由服务端填写",
      "column mes_material_issue update_time datetime YES 最后修改时间，由服务端填写",
      "column mes_material_issue_item id bigint NO 领料出库明细本地主键",
      "column mes_material_issue_item factory_id varchar(64) NO 所属工厂标识，由服务端当前上下文填写",
      "column mes_material_issue_item issue_id bigint NO 所属本地领料出库单主键",
      "column mes_material_issue_item material_id bigint NO 领用材料主键，逻辑引用本厂物料产品资料",
      "column mes_material_issue_item material_code varchar(64) YES 领用材料品号快照，由服务端从物料资料填写",
      "column mes_material_issue_item batch_no varchar(128) YES 来源材料批次号，普通字符串，不校验编码规则",
      "column mes_material_issue_item quantity decimal(20,6) NO 本次领料数量，保留六位小数，不等于生产或报工数量",
      "column mes_material_issue_item unit_id bigint YES 本次领料计量单位主键，空值表示未提供",
      "column mes_material_issue_item unit_code varchar(64) YES 本次领料单位编码快照，由服务端填写",
      "column mes_material_issue_item warehouse_id bigint YES 领料来源仓库主键，空值表示未提供",
      "column mes_material_issue_item warehouse_code varchar(64) YES 来源仓库编码快照，由服务端填写",
      "column mes_material_issue_item remark varchar(500) YES 领料明细备注",
      "column mes_material_issue_item create_by varchar(64) YES 创建人系统用户标识，由服务端填写",
      "column mes_material_issue_item create_time datetime YES 创建时间，由服务端填写",
      "column mes_material_issue_item update_by varchar(64) YES 最后修改人系统用户标识，由服务端填写",
      "column mes_material_issue_item update_time datetime YES 最后修改时间，由服务端填写",
      "index idx_issue_flow_card 1 factory_id,flow_card_no",
      "index idx_issue_no 1 factory_id,issue_no",
      "index idx_issue_routing 1 factory_id,routing_id",
      "index idx_issue_workorder 1 factory_id,workorder_id",
      "index idx_issue_workorder_code 1 factory_id,workorder_code",
      "index PRIMARY 0 id",
      "index idx_issue_item_material 1 factory_id,material_id",
      "index idx_issue_item_material_batch 1 factory_id,material_code,batch_no",
      "index idx_issue_item_parent 1 factory_id,issue_id",
      "index idx_issue_item_warehouse 1 factory_id,warehouse_id",
      "index PRIMARY 0 id",
      "rolled-back fixture rows=0"
    ]
