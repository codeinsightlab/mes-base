<?xml version="1.0" encoding="UTF-8" ?>
<!-- MES-CODEGEN: adapted RuoYi mapper.xml.vm (MIT; docs/legal/ruoyi-MIT-LICENSE.txt). -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${packageName}.${ClassName}Mapper">
    <resultMap type="${packageName}.${ClassName}Entity" id="Row">
#foreach($column in $columns)
        #if($column.primary)<id#else<result#end property="${column.javaField}" column="${column.columnName}" />
#end
    </resultMap>
    <sql id="Columns">
#foreach($column in $columns)
        ${column.sqlName}#if($foreach.hasNext),#end
#end
    </sql>
    <sql id="Where">
        <where>
#if($scoped)
            ${sqlFactory}=#{factory}
#end
#foreach($column in $editColumns)
            <if test="q.${column.javaField} != null">
                AND ${column.sqlName}#if($column.string) LIKE CONCAT('%',#{q.${column.javaField}},'%')#else=#{q.${column.javaField}}#end
            </if>
#end
        </where>
    </sql>
    <select id="list" resultMap="Row">
        SELECT <include refid="Columns"/> FROM ${sqlTable}
        <include refid="Where"/>
        ORDER BY ${sqlPk} LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM ${sqlTable} <include refid="Where"/>
    </select>
    <select id="detail" resultMap="Row">
        SELECT <include refid="Columns"/> FROM ${sqlTable}
        WHERE #if($scoped)${sqlFactory}=#{factory} AND #end${sqlPk}=#{id}
    </select>
    <insert id="insert"#if($pkAuto) useGeneratedKeys="true" keyProperty="${pkField}" keyColumn="${pkColumnName}"#end>
        INSERT INTO ${sqlTable} (
#foreach($column in $insertColumns)
            ${column.sqlName}#if($foreach.hasNext),#end
#end
        ) VALUES (
#foreach($column in $insertColumns)
            #{${column.javaField}}#if($foreach.hasNext),#end
#end
        )
    </insert>
    <update id="update">
        UPDATE ${sqlTable} SET
#foreach($column in $editColumns)
            ${column.sqlName}=#{row.${column.javaField}}#if($foreach.hasNext),#end
#end
        WHERE #if($scoped)${sqlFactory}=#{factory} AND #end${sqlPk}=#{row.${pkField}}
    </update>
    <delete id="delete">
        DELETE FROM ${sqlTable}
        WHERE #if($scoped)${sqlFactory}=#{factory} AND #end${sqlPk}=#{id}
    </delete>
</mapper>
