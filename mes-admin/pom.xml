<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.mesbase</groupId>
        <artifactId>mes-base</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>mes-admin</artifactId>
    <dependencies>
        <dependency>
            <groupId>dev.mesbase</groupId>
            <artifactId>mes-quartz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.mesbase</groupId>
            <artifactId>mes-generator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>3.0.3</version>
        </dependency>
    </dependencies>
    <build>
        <directory>${maven.multiModuleProjectDirectory}/target/mes-admin</directory>
        <finalName>mes-base-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <systemPropertyVariables>
                        <!-- Unit/fixture tests must not import the private developer profile. -->
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <outputDirectory>${maven.multiModuleProjectDirectory}/target</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <outputDirectory>${maven.multiModuleProjectDirectory}/target</outputDirectory>
                    <mainClass>dev.MesBaseApplication</mainClass>
                    <excludes><exclude><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></exclude></excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
