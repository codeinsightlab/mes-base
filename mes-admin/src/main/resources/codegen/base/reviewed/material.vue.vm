<!-- MES-CODEGEN: generated foundation with reviewed SIMPLE business fields. -->
<script setup lang="ts">
import { computed, ref, watch } from 'vue'
import CrudPage from '@/components/CrudPage.vue'
#if($generateSync)
import SyncButton from '@/components/business/SyncButton.vue'
#end
import { api } from '${frontendApiImport}'
#if($generateSync)
import { sync } from '${frontendApiImport}'
#end
import { formatValue } from '@/lib/crud'
import type { Field } from '@/lib/crud'
import type { MaterialVo } from '@/api/material/material'
import { useAuth } from '@/stores/auth'
import { useBasicDataReferences } from '@/lib/basicDataReferences'
import { api as categoryIdApi } from '@/api/material/materialCategory'
import { api as unitIdApi } from '@/api/material/unitMeasure'
const page = ref<InstanceType<typeof CrudPage> | null>(null)
const { options: categoryIdOptions, reload: categoryIdReload } = useBasicDataReferences(categoryIdApi, 'business:material:category')
const { options: unitIdOptions, reload: unitIdReload } = useBasicDataReferences(unitIdApi, 'business:unit:measure')
const auth = useAuth()
const detail = ref<MaterialVo | null>(null)
const detailLoading = ref(false)
const detailError = ref('')
const detailVisible = ref(false)
let detailRequest = 0
async function showDetail(id: string) {
  if (!auth.hasPermission('${permission}:${queryAction}', 'factory')) return
  const current = ++detailRequest
  const revision = auth.revision
  detail.value = null
  detailError.value = ''
  detailVisible.value = true
  detailLoading.value = true
  try {
    const result = await api.detail(id)
    if (current === detailRequest && revision === auth.revision) detail.value = result
  } catch (error) {
    if (current === detailRequest && revision === auth.revision) {
      detailError.value = error instanceof Error ? error.message : '详情加载失败'
    }
  } finally {
    if (current === detailRequest) detailLoading.value = false
  }
}
function clearDetail() {
  detailRequest++
  detailVisible.value = false
  detail.value = null
  detailError.value = ''
  detailLoading.value = false
}
watch(() => auth.revision, clearDetail)
watch(() => auth.hasPermission('${permission}:${queryAction}', 'factory'), allowed => {
  if (!allowed) clearDetail()
})
const fields = computed<Field[]>(() => [
  { key: 'id', label: '编号', kind: 'text', readonly: true },
  { key: 'code', label: '物料编码', kind: 'text', required: true, searchable: true, maxLength: 64 },
  { key: 'name', label: '物料名称', kind: 'text', required: true, searchable: true, maxLength: 255 },
  { key: 'specification', label: '规格型号', kind: 'textarea', required: false, searchable: false, maxLength: 500 },
  { key: 'categoryId', label: '物料分类', kind: 'select', required: false, searchable: false, maxLength: 500, options: categoryIdOptions.value },
  { key: 'unitId', label: '计量单位', kind: 'select', required: true, searchable: false, maxLength: 500, options: unitIdOptions.value },
  { key: 'materialType', label: '物料产品标识', kind: 'select', required: true, searchable: false, maxLength: 500, options: [{ label: '物料', value: 'ITEM' }, { label: '产品', value: 'PRODUCT' }], defaultValue: 'ITEM' },
  { key: 'status', label: '状态', kind: 'select', required: true, searchable: false, maxLength: 500, options: [{ label: '启用', value: 'ENABLED', tone: 'success' }, { label: '停用', value: 'DISABLED', tone: 'info' }], defaultValue: 'ENABLED' },
])
</script>
<template>
  <CrudPage table-key="${permission}:list" list-action="${listAction}" detail-action="${queryAction}" @changed="categoryIdReload(); unitIdReload()" ref="page" title="物料产品" permission="${permission}" :api="api" :fields="fields" id-key="id">
#if($generateSync)
    <template #toolbar>
      <SyncButton permission="business:material:sync" scope="factory" :run="sync" @completed="page?.load()" />
    </template>
#end
    <template #actions="{ row }">
      <el-button v-if="row.id != null && auth.hasPermission('${permission}:${queryAction}', 'factory')" text type="primary"
                 @click="showDetail(String(row.id))">详情</el-button>
    </template>
  </CrudPage>
  <el-dialog v-model="detailVisible" title="物料产品详情" width="min(640px,92vw)" @closed="clearDetail">
    <div v-loading="detailLoading">
      <el-alert v-if="detailError" :title="detailError" type="error" :closable="false" />
      <el-descriptions v-if="detail" :column="1" border>
        <el-descriptions-item v-for="field in fields" :key="field.key" :label="field.label">
          {{ field.options?.find(option => String(option.value) === String(detail![field.key]))?.label
            ?? formatValue(detail[field.key], field.kind) }}
        </el-descriptions-item>
      </el-descriptions>
    </div>
  </el-dialog>
</template>
