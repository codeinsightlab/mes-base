#else
    public static final String READ = #if($scoped)${domainPackage}.${ClassName}Resource.PREFIX + ":read"#else"${permission}:read"#end;
#end
    public static final String CREATE = #if($scoped)${domainPackage}.${ClassName}Resource.PREFIX + ":create"#else"${permission}:create"#end;
    public static final String UPDATE = #if($scoped)${domainPackage}.${ClassName}Resource.PREFIX + ":update"#else"${permission}:update"#end;
    public static final String DELETE = #if($scoped)${domainPackage}.${ClassName}Resource.PREFIX + ":delete"#else"${permission}:delete"#end;

#if($generateSync)
    public static final String SYNC = #if($scoped)${domainPackage}.${ClassName}Resource.PREFIX + ":sync"#else"${permission}:sync"#end;
#end

    private ${ClassName}Permissions() {
    }
}
