// MES-CODEGEN: RuoYi API module pattern adapted to typed Base contracts.
import { request } from '${requestModule}'

export interface ${ClassName}Vo {
  [key: string]: unknown;
#foreach($field in $fields)
  ${field.name}: ${field.type}#if($field.nullable) | null#end;
#end
}

export interface Page {
  items: ${ClassName}Vo[];
  total: number;
  offset: number;
  limit: number;
}

export type CreateCommand = Pick<${ClassName}Vo, #foreach($field in $writableFields)'${field}'#if($foreach.hasNext) | #end#end>
export type UpdateCommand = Pick<${ClassName}Vo, #foreach($field in $updateFields)'${field}'#if($foreach.hasNext) | #end#end>

const removeIds = (ids: string[]) =>
  request<void>('${route}', { method: 'DELETE', body: ids, scope: '${permissionScope}' })

export const api = {
  list: (query: Record<string, string | number>) =>
    request<Page>('${route}', { query, scope: '${permissionScope}' }),

  detail: (id: string) =>
    request<${ClassName}Vo>('${route}/' + encodeURIComponent(id), { scope: '${permissionScope}' }),

  create: (body: unknown) =>
    request<${ClassName}Vo>('${route}', { method: 'POST', body, scope: '${permissionScope}' }),

  update: (id: string, body: unknown) =>
    request<${ClassName}Vo>('${route}/' + encodeURIComponent(id), {
      method: 'PUT', body, scope: '${permissionScope}'
    }),

  remove: (id: string) => removeIds([id]),

  delids: removeIds
}
