UPDATE ${menuTable} SET menu_name = '${menuDirectorySql}', order_num = ${directoryOrder}, icon = '${menuIcon}'
WHERE parent_id = ${parentId} AND path = '${moduleName}' AND menu_type = 'M';
INSERT INTO ${menuTable} (menu_name, parent_id, order_num, path, menu_type, icon, create_by, create_time)
SELECT '${menuDirectorySql}', ${parentId}, ${directoryOrder}, '${moduleName}', 'M', '${menuIcon}', '${createdBy}', CURRENT_TIMESTAMP
WHERE NOT EXISTS (
    SELECT 1 FROM ${menuTable} WHERE parent_id = ${parentId} AND path = '${moduleName}' AND menu_type = 'M'
);

UPDATE ${menuTable} SET menu_name = '${menuNameSql}', order_num = ${pageOrder}, path = '${className}',
    component = '${pageComponent}', icon = '${menuIcon}',
    parent_id = (SELECT directory.menu_id FROM (SELECT menu_id FROM ${menuTable}
        WHERE parent_id = ${parentId} AND path = '${moduleName}' AND menu_type = 'M') directory)
WHERE perms = '${permission}:${listAction}' AND menu_type = 'C';
INSERT INTO ${menuTable} (menu_name, parent_id, order_num, path, component, menu_type, perms, icon, create_by, create_time)
SELECT '${menuNameSql}', directory.menu_id, ${pageOrder}, '${className}', '${pageComponent}',
       'C', '${permission}:${listAction}', '${menuIcon}', '${createdBy}', CURRENT_TIMESTAMP
FROM ${menuTable} directory
WHERE directory.parent_id = ${parentId} AND directory.path = '${moduleName}' AND directory.menu_type = 'M'
  AND NOT EXISTS (SELECT 1 FROM ${menuTable} WHERE perms = '${permission}:${listAction}' AND menu_type = 'C');

