        WHERE perms = '${permission}:${listAction}' AND menu_type = 'C') page)
WHERE perms = '${permission}:${action.code}' AND menu_type = 'F';
INSERT INTO ${menuTable} (menu_name, parent_id, order_num, path, menu_type, perms, create_by, create_time)
SELECT '${menuNameSql}${action.label}', page.menu_id, ${foreach.index}, '#', 'F', '${permission}:${action.code}',
       '${createdBy}', CURRENT_TIMESTAMP
FROM ${menuTable} page
WHERE page.perms = '${permission}:${listAction}' AND page.menu_type = 'C'
