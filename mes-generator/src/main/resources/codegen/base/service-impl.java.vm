/**
 * ${functionNameJavaDoc} CRUD：规则与事务由 Service 负责，Mapper 通过 MyBatis-Spring 注入。
 */
@org.springframework.stereotype.Service
#if($conditionalEnabled)
@org.springframework.boot.autoconfigure.condition.ConditionalOnProperty(name = "${conditionalProperty}", havingValue = "${conditionalValue}")
#end
public class ${ClassName}ServiceImpl implements ${servicePackage}.I${ClassName}Service {
    private final ${daoPackage}.${ClassName}Mapper mapper;
#if($generateSync)
    private final ${syncPackage}.${ClassName}QueryPort query;
    private final dev.mesbase.framework.sync.SyncCoordinator coordinator;
    private final org.springframework.beans.factory.ObjectProvider<${servicePackage}.I${ClassName}Service> self;
    private final jakarta.validation.Validator validator;
    private final dev.mesbase.infrastructure.cache.BusinessCacheProcessor caches;
#end

    public ${ClassName}ServiceImpl(${daoPackage}.${ClassName}Mapper mapper#if($generateSync),
            org.springframework.beans.factory.ObjectProvider<${syncPackage}.${ClassName}QueryPort> queries,
            dev.mesbase.framework.sync.SyncCoordinator coordinator,
            org.springframework.beans.factory.ObjectProvider<${servicePackage}.I${ClassName}Service> self,
            jakarta.validation.Validator validator, dev.mesbase.infrastructure.cache.BusinessCacheProcessor caches#end) {
        this.mapper = mapper;
#if($generateSync)
        this.query = queries.getIfAvailable(${syncPackage}.Unconfigured${ClassName}QueryAdapter::new);
        this.coordinator = coordinator;
        this.self = self;
        this.validator = validator;
        this.caches = caches;
#end
    }

    @Override
    @org.springframework.transaction.annotation.Transactional(transactionManager = "${transactionManager}", readOnly = true)
#if($scoped)
    @dev.mesbase.infrastructure.cache.annotation.BusinessCache(business = ${domainPackage}.${ClassName}Resource.PREFIX,
            type = dev.mesbase.infrastructure.cache.annotation.BusinessCache.Type.LIST)
#end
    public ${domainPackage}.${ClassName}Page selectPage(${domainPackage}.${ClassName}QueryDto query) {
        int offset = query.offset() == null ? 0 : query.offset();
        int limit = query.limit() == null ? ${pageDefault} : query.limit();
        if (offset < 0 || limit < 1 || limit > ${pageMaximum}) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.BAD_REQUEST);
        }
        ${domainPackage}.${ClassName}Example example = new ${domainPackage}.${ClassName}Example();
        ${domainPackage}.${ClassName}Example.Criteria criteria = example.createCriteria();
#if($serverScope)
        criteria.and${scopeField.name.substring(0,1).toUpperCase()}${scopeField.name.substring(1)}EqualTo(dev.mesbase.platform.execution.FactoryContext.required().factoryId().value());
#end
#foreach($field in $queryFields)
        if (query.${field.name}() != null) {
            criteria.${field.criteriaMethod}(#if($field.string)"%" + query.${field.name}() + "%"#else query.${field.name}()#end);
        }
#end
        example.setOrderByClause("${sqlPk}");
        try (com.github.pagehelper.Page<${domainPackage}.${ClassName}Entity> page = com.github.pagehelper.PageHelper.offsetPage(offset, limit)) {
            java.util.List<${domainPackage}.${ClassName}Entity> rows = mapper.${selectByExampleMethod}(example);
            return new ${domainPackage}.${ClassName}Page(rows, page.getTotal(), offset, limit);
        }
    }

    @Override
    @org.springframework.transaction.annotation.Transactional(transactionManager = "${transactionManager}", readOnly = true)
#if($scoped)
    @dev.mesbase.infrastructure.cache.annotation.BusinessCache(business = ${domainPackage}.${ClassName}Resource.PREFIX,
            type = dev.mesbase.infrastructure.cache.annotation.BusinessCache.Type.DETAIL)
#end
    public ${domainPackage}.${ClassName}Entity selectById(${idType} id) {
        return requireRecord(id);
    }

    @Override
    @org.springframework.transaction.annotation.Transactional(transactionManager = "${transactionManager}", rollbackFor = Exception.class)
#if($scoped)
    @dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict(business = ${domainPackage}.${ClassName}Resource.PREFIX,
            scope = dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict.Scope.LIST)
#end
    public ${domainPackage}.${ClassName}Entity insert(${domainPackage}.${ClassName}CreateCommand input) {
        ${domainPackage}.${ClassName}Entity row = new ${domainPackage}.${ClassName}Entity();
#if($serverScope)
        row.${scopeField.setter}(dev.mesbase.platform.execution.FactoryContext.required().factoryId().value());
#end
#foreach($field in $createFields)
        row.${field.setter}(input.${field.name}());
#end
        if (mapper.insert(row) != 1) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.RESOURCE_CONFLICT);
        }
        return requireRecord(row.get${pkField.substring(0,1).toUpperCase()}${pkField.substring(1)}());
    }

    @Override
    @org.springframework.transaction.annotation.Transactional(transactionManager = "${transactionManager}", rollbackFor = Exception.class)
#if($scoped)
    @dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict(business = ${domainPackage}.${ClassName}Resource.PREFIX,
            scope = dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict.Scope.LIST_AND_DETAIL)
#end
    public ${domainPackage}.${ClassName}Entity updateById(${idType} id, ${domainPackage}.${ClassName}UpdateCommand input) {
        ${domainPackage}.${ClassName}Entity row = requireRecord(id);
        row.set${pkField.substring(0,1).toUpperCase()}${pkField.substring(1)}(id);
#foreach($field in $editFields)
        row.${field.setter}(input.${field.name}());
#end
        if (mapper.${updateByPrimaryKeyMethod}(row) != 1) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.RESOURCE_CONFLICT);
        }
        return requireRecord(id);
    }

    @Override
    @org.springframework.transaction.annotation.Transactional(transactionManager = "${transactionManager}", rollbackFor = Exception.class)
#if($scoped)
    @dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict(business = ${domainPackage}.${ClassName}Resource.PREFIX,
            scope = dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict.Scope.LIST_AND_DETAIL)
#end
    public void deleteByIds(java.util.List<${idType}> ids) {
        if (ids == null || ids.isEmpty() || ids.size() > ${batchDeleteMaximum} || ids.stream().anyMatch(java.util.Objects::isNull)
                || new java.util.HashSet<>(ids).size() != ids.size()) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.BAD_REQUEST);
        }
        ${domainPackage}.${ClassName}Example example = new ${domainPackage}.${ClassName}Example();
        for (var id : ids) requireRecord(id);
        example.createCriteria().and${pkField.substring(0,1).toUpperCase()}${pkField.substring(1)}In(ids)
#if($serverScope)
                .and${scopeField.name.substring(0,1).toUpperCase()}${scopeField.name.substring(1)}EqualTo(dev.mesbase.platform.execution.FactoryContext.required().factoryId().value())
#end
                ;
        if (mapper.deleteByExample(example) != ids.size()) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.RESOURCE_CONFLICT);
        }
    }

    private ${domainPackage}.${ClassName}Entity requireRecord(${idType} id) {
        ${domainPackage}.${ClassName}Entity row = mapper.selectByPrimaryKey(id);
        if (row == null#if($serverScope) || !dev.mesbase.platform.execution.FactoryContext.required().factoryId().value().equals(row.${scopeField.getter}())#end) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.NOT_FOUND);
        }
        return row;
    }
#if($generateSync)
    public ${syncPackage}.${ClassName}SyncResult sync(dev.mesbase.core.factory.FactoryScope scope) {
        if (!dev.mesbase.platform.execution.FactoryContext.required().equals(scope)) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.CONFLICT);
        }
        var inputs = query.query(scope, ${syncBatchMaximum});
        var run = coordinator.claim(scope, "${syncTaskKey}", java.time.Duration.ofMinutes(5));
        try {
            coordinator.progress(run, 0);
            var result = self.getObject().upsert(scope, inputs);
            coordinator.progress(run, result.fetched());
            coordinator.succeed(run, null);
            return result;
        } catch (RuntimeException failure) {
            try {
                coordinator.fail(run);
            } catch (RuntimeException deliveryFailure) {
                failure.addSuppressed(deliveryFailure);
            }
            throw failure;
        }
    }

    @org.springframework.transaction.annotation.Transactional(transactionManager = "${transactionManager}", rollbackFor = Exception.class)
    public ${syncPackage}.${ClassName}SyncResult upsert(dev.mesbase.core.factory.FactoryScope scope,
                                       java.util.List<${syncPackage}.External${ClassName}> inputs) {
        if (!dev.mesbase.platform.execution.FactoryContext.required().equals(scope)) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.CONFLICT);
        }
        if (inputs == null || inputs.size() > ${syncBatchMaximum}) {
            throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.BAD_REQUEST);
        }
        var keys = new java.util.HashSet<${syncKey.type}>();
        for (var input : inputs) {
            if (input == null || !validator.validate(input).isEmpty() || !keys.add(input.${syncKey.name}())) {
                throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.BAD_REQUEST);
            }
        }
        if (inputs.isEmpty()) return new ${syncPackage}.${ClassName}SyncResult(0, 0, 0, 0);
        var example = new ${domainPackage}.${ClassName}Example();
        example.createCriteria().${syncKeyIn}(java.util.List.copyOf(keys))
#if($serverScope)
                .and${scopeField.name.substring(0,1).toUpperCase()}${scopeField.name.substring(1)}EqualTo(scope.factoryId().value())
#end
                ;
        var existing = new java.util.HashMap<${syncKey.type}, ${domainPackage}.${ClassName}Entity>();
        for (var row : mapper.${selectByExampleMethod}(example)) {
            if (existing.put(row.${syncKey.getter}(), row) != null) {
                throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.RESOURCE_CONFLICT);
            }
        }
        int created = 0;
        int updated = 0;
        int skipped = 0;
        for (var input : inputs) {
            var row = existing.get(input.${syncKey.name}());
#if($syncHasInputPk)
            if (row != null && !java.util.Objects.equals(row.${pkGetter}(), input.${pkField}())) {
                throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.RESOURCE_CONFLICT);
            }
#end
            if (row != null && same(row, input)) {
                skipped++;
                continue;
            }
            boolean insert = row == null;
            if (insert) {
                row = new ${domainPackage}.${ClassName}Entity();
#if($serverScope)
                row.${scopeField.setter}(scope.factoryId().value());
#end
#if($syncHasInputPk)
                row.${pkSetter}(input.${pkField}());
#end
            }
#foreach($field in $syncWritableFields)
            row.${field.setter}(input.${field.name}());
#end
            int affected = insert ? mapper.insertSelective(row) : mapper.${updateByPrimaryKeyMethod}(row);
            if (affected != 1) throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.RESOURCE_CONFLICT);
            if (insert) created++;
            else updated++;
        }
        if (updated > 0) {
            caches.evict(${domainPackage}.${ClassName}Resource.PREFIX,
                    dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict.Scope.LIST_AND_DETAIL);
        } else if (created > 0) {
            caches.evict(${domainPackage}.${ClassName}Resource.PREFIX,
                    dev.mesbase.infrastructure.cache.annotation.BusinessCacheEvict.Scope.LIST);
        }
        return new ${syncPackage}.${ClassName}SyncResult(inputs.size(), created, updated, skipped);
    }

    private static boolean same(${domainPackage}.${ClassName}Entity row, ${syncPackage}.External${ClassName} input) {
#if($syncWritableFields.isEmpty())
        return true;
#else
#foreach($field in $syncWritableFields)
#if($foreach.first)
#set($comparisonPrefix = "        return")
#else
#set($comparisonPrefix = "                &&")
#end
#if($field.decimal)
${comparisonPrefix} (row.${field.getter}() == null ? input.${field.name}() == null
                    : input.${field.name}() != null && row.${field.getter}().compareTo(input.${field.name}()) == 0)#if($foreach.last);#end
#else
${comparisonPrefix} java.util.Objects.deepEquals(row.${field.getter}(), input.${field.name}())#if($foreach.last);#end
#end
#end
#end
    }
#end
}
