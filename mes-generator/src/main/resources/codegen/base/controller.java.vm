/**
 * ${functionNameJavaDoc} HTTP 接口，响应转换显式发生在 Web 边界。
 */
@org.springframework.web.bind.annotation.RestController
@org.springframework.web.bind.annotation.RequestMapping("${route}")
#if($conditionalEnabled)
@org.springframework.boot.autoconfigure.condition.ConditionalOnProperty(name = "${conditionalProperty}", havingValue = "${conditionalValue}")
#end
public class ${ClassName}Controller {
    private final ${servicePackage}.I${ClassName}Service service;

    public ${ClassName}Controller(${servicePackage}.I${ClassName}Service service) {
        this.service = service;
    }

    @org.springframework.web.bind.annotation.GetMapping
    @dev.mesbase.platform.web.EndpointAccess(value = dev.mesbase.platform.web.EndpointAccess.Kind.AUTHORIZED,
            permission = ${ClassName}Permissions.${listPermissionConstant}#if(!$scoped), permissionScope = dev.mesbase.platform.web.EndpointAccess.PermissionScope.PLATFORM#end)
    public ${responsePackage}.${ClassName}PageVo list(@jakarta.validation.Valid @org.springframework.web.bind.annotation.ModelAttribute ${domainPackage}.${ClassName}QueryDto query) {
        return dev.mesbase.common.utils.bean.BeanConversions.convertPage(service.selectPage(query), ${responsePackage}.${ClassName}PageVo.class);
    }

    @org.springframework.web.bind.annotation.GetMapping("/{id}")
    @dev.mesbase.platform.web.EndpointAccess(value = dev.mesbase.platform.web.EndpointAccess.Kind.AUTHORIZED,
            permission = ${ClassName}Permissions.${queryPermissionConstant}#if(!$scoped), permissionScope = dev.mesbase.platform.web.EndpointAccess.PermissionScope.PLATFORM#end)
    public ${responsePackage}.${ClassName}Vo detail(@org.springframework.web.bind.annotation.PathVariable ${idType} id) {
        return toView(service.selectById(id));
    }

    @org.springframework.web.bind.annotation.PostMapping
    @dev.mesbase.platform.web.EndpointAccess(value = dev.mesbase.platform.web.EndpointAccess.Kind.AUTHORIZED,
            permission = ${ClassName}Permissions.CREATE#if(!$scoped), permissionScope = dev.mesbase.platform.web.EndpointAccess.PermissionScope.PLATFORM#end)
    public ${responsePackage}.${ClassName}Vo create(@jakarta.validation.Valid @org.springframework.web.bind.annotation.RequestBody ${domainPackage}.${ClassName}CreateCommand input) {
        return toView(service.insert(input));
    }

    @org.springframework.web.bind.annotation.PutMapping("/{id}")
    @dev.mesbase.platform.web.EndpointAccess(value = dev.mesbase.platform.web.EndpointAccess.Kind.AUTHORIZED,
            permission = ${ClassName}Permissions.UPDATE#if(!$scoped), permissionScope = dev.mesbase.platform.web.EndpointAccess.PermissionScope.PLATFORM#end)
    public ${responsePackage}.${ClassName}Vo update(@org.springframework.web.bind.annotation.PathVariable ${idType} id,
            @jakarta.validation.Valid @org.springframework.web.bind.annotation.RequestBody ${domainPackage}.${ClassName}UpdateCommand input) {
        return toView(service.updateById(id, input));
    }

    @org.springframework.web.bind.annotation.DeleteMapping
    @org.springframework.web.bind.annotation.ResponseStatus(org.springframework.http.HttpStatus.NO_CONTENT)
    @dev.mesbase.platform.web.EndpointAccess(value = dev.mesbase.platform.web.EndpointAccess.Kind.AUTHORIZED,
            permission = ${ClassName}Permissions.DELETE#if(!$scoped), permissionScope = dev.mesbase.platform.web.EndpointAccess.PermissionScope.PLATFORM#end)
    public void delete(@org.springframework.web.bind.annotation.RequestBody
            @jakarta.validation.constraints.NotEmpty @jakarta.validation.constraints.Size(max = ${batchDeleteMaximum})
            java.util.List<@jakarta.validation.constraints.NotNull ${idType}> ids) {
        service.deleteByIds(ids);
    }

#if($generateSync)
    @org.springframework.web.bind.annotation.PostMapping("/actions/sync")
    @dev.mesbase.platform.web.EndpointAccess(value = dev.mesbase.platform.web.EndpointAccess.Kind.AUTHORIZED,
            permission = ${ClassName}Permissions.SYNC)
    public ${syncPackage}.${ClassName}SyncResult sync() {
        return service.sync(dev.mesbase.platform.execution.FactoryContext.required());
    }
#end

    private static ${responsePackage}.${ClassName}Vo toView(${domainPackage}.${ClassName}Entity row) {
        return dev.mesbase.common.utils.bean.BeanConversions.convert(row, ${responsePackage}.${ClassName}Vo.class);
    }
}
