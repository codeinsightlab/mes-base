<!-- MES-CODEGEN: Base Design System; shared CRUD interactions and explicit field contract. -->
<script setup lang="ts">
import CrudPage from '${crudComponent}'
import { api } from '${frontendApiImport}'
import type { Field } from '${fieldTypesModule}'
#if($generateSync)
import { ref } from 'vue'
import { sync } from '${frontendApiImport}'
import SyncButton from '@/components/business/SyncButton.vue'
const page = ref<InstanceType<typeof CrudPage> | null>(null)
#end

const fields: Field[] = [
#foreach($field in $fields)
  {
    key: '${field.name}',
    label: '${field.label}',
    kind: '${field.kind}',
    readonly: ${field.readonly},
    required: ${field.required},
    searchable: ${field.searchable},
    maxLength: ${field.maxLength}
  }#if($foreach.hasNext),#end
#end
]
</script>

<template>
  <CrudPage
#if($generateSync)
    ref="page"
#end
    table-key="${permission}:list"
    title="${functionNameHtml}"
    permission="${permission}"
    list-action="${listAction}"
    detail-action="${queryAction}"
#if(!$scoped)
    permission-scope="platform"
#end
    :api="api"
    :fields="fields"
    id-key="${pkField}"
#if($generateSync)
  >
    <template #toolbar>
      <SyncButton permission="${permission}:sync" scope="${permissionScope}" :run="sync" @completed="page?.load()" />
    </template>
  </CrudPage>
#else
  />
#end
</template>
