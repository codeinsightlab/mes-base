#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_java=$(git diff --cached --name-only --diff-filter=ACMR -- '*.java')
if [ -z "$staged_java" ]; then
  exit 0
fi

files=$(printf '%s\n' "$staged_java" | paste -sd, -)
echo "Formatting staged Java files with Spotless..."
mvn -B -ntp spotless:apply "-DspotlessFiles=$files"

printf '%s\n' "$staged_java" | while IFS= read -r file; do
  [ -n "$file" ] && git add -- "$file"
done

git diff --cached --check
