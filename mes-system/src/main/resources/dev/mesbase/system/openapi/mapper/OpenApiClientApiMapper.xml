<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.mesbase.system.openapi.mapper.OpenApiClientApiMapper">
    <resultMap id="Result" type="dev.mesbase.system.openapi.domain.OpenApiClientApi">
        <result property="id" column="id"/>
        <result property="clientId" column="client_id"/>
        <result property="apiCode" column="api_code"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <sql id="columns">id, client_id, api_code, create_by, create_time</sql>
    <select id="selectById" resultMap="Result">
        select <include refid="columns"/> from open_api_client_api where id = #{id}
    </select>
    <select id="selectList" resultMap="Result">
        select <include refid="columns"/> from open_api_client_api
        <where>
            <if test="clientId != null">and client_id = #{clientId}</if>
            <if test="apiCode != null">and api_code = #{apiCode}</if>
        </where>
        order by id desc
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into open_api_client_api
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="clientId != null">client_id,</if>
            <if test="apiCode != null">api_code,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="clientId != null">#{clientId},</if>
            <if test="apiCode != null">#{apiCode},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>
    <update id="update">
        update open_api_client_api
        <set>
            <if test="clientId != null">client_id = #{clientId},</if>
            <if test="apiCode != null">api_code = #{apiCode},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        where id = #{id}
    </update>
    <delete id="deleteById">delete from open_api_client_api where id = #{id}</delete>
    <delete id="deleteByIds">
        delete from open_api_client_api where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
