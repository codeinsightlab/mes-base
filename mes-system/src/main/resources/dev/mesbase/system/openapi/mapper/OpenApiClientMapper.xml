<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.mesbase.system.openapi.mapper.OpenApiClientMapper">
    <resultMap id="Result" type="dev.mesbase.system.openapi.domain.OpenApiClient">
        <result property="clientId" column="client_id"/>
        <result property="appKey" column="app_key"/>
        <result property="secretHash" column="secret_hash"/>
        <result property="clientName" column="client_name"/>
        <result property="status" column="status"/>
        <result property="credentialVersion" column="credential_version"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="columns">client_id, app_key, secret_hash, client_name, status, credential_version, create_by, create_time, update_by, update_time, remark</sql>
    <select id="selectById" resultMap="Result">
        select <include refid="columns"/> from open_api_client where client_id = #{id}
    </select>
    <select id="selectList" resultMap="Result">
        select <include refid="columns"/> from open_api_client
        <where>
            <if test="appKey != null">and app_key = #{appKey}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by client_id desc
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="clientId">
        insert into open_api_client
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="appKey != null">app_key,</if>
            <if test="secretHash != null">secret_hash,</if>
            <if test="clientName != null">client_name,</if>
            <if test="status != null">status,</if>
            <if test="credentialVersion != null">credential_version,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appKey != null">#{appKey},</if>
            <if test="secretHash != null">#{secretHash},</if>
            <if test="clientName != null">#{clientName},</if>
            <if test="status != null">#{status},</if>
            <if test="credentialVersion != null">#{credentialVersion},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="update">
        update open_api_client
        <set>
            <if test="appKey != null">app_key = #{appKey},</if>
            <if test="secretHash != null">secret_hash = #{secretHash},</if>
            <if test="clientName != null">client_name = #{clientName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="credentialVersion != null">credential_version = #{credentialVersion},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where client_id = #{clientId}
    </update>
    <delete id="deleteById">delete from open_api_client where client_id = #{id}</delete>
    <delete id="deleteByIds">
        delete from open_api_client where client_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
    <select id="selectByAppKey" resultMap="dev.mesbase.system.openapi.mapper.OpenApiClientMapper.Result">
        select <include refid="dev.mesbase.system.openapi.mapper.OpenApiClientMapper.columns"/>
        from open_api_client where app_key = #{appKey}
    </select>
    <select id="lockById" resultMap="dev.mesbase.system.openapi.mapper.OpenApiClientMapper.Result">
        select <include refid="dev.mesbase.system.openapi.mapper.OpenApiClientMapper.columns"/>
        from open_api_client where client_id = #{clientId} for update
    </select>
    <update id="changeCredentials">
        update open_api_client
        <set>
            credential_version = credential_version + 1,
            update_by = #{updateBy}, update_time = current_timestamp,
            <if test="secretHash != null">secret_hash = #{secretHash},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where client_id = #{clientId}
    </update>
</mapper>
