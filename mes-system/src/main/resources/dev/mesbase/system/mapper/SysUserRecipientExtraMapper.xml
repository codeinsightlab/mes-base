<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.mesbase.system.mapper.SysUserRecipientExtraMapper">
    <resultMap id="UserDisplay" type="dev.mesbase.common.core.domain.entity.SysUser">
        <id property="userId" column="user_id"/>
        <result property="deptId" column="dept_id"/>
        <result property="userName" column="user_name"/>
        <result property="nickName" column="nick_name"/>
        <result property="email" column="email"/>
        <result property="phonenumber" column="phonenumber"/>
        <result property="sex" column="sex"/>
        <association property="dept" javaType="dev.mesbase.common.core.domain.entity.SysDept">
            <result property="deptName" column="dept_name"/>
        </association>
    </resultMap>
    <select id="selectUsers" resultMap="UserDisplay">
        SELECT u.user_id,u.dept_id,u.user_name,u.nick_name,u.email,u.phonenumber,u.sex,d.dept_name
        FROM sys_user u LEFT JOIN sys_dept d ON u.dept_id=d.dept_id
        WHERE u.del_flag='0'
        <if test="userIds != null">
            <choose>
                <when test="userIds.size() > 0">AND u.user_id IN
                    <foreach collection="userIds" item="id" open="(" close=")" separator=",">#{id}</foreach>
                </when>
                <otherwise>AND 1=0</otherwise>
            </choose>
        </if>
        <if test="userId != null">AND u.user_id=#{userId}</if>
        <if test="deptId != null">AND u.dept_id=#{deptId}</if>
        <if test="deptName != null and deptName != ''">AND d.dept_name LIKE concat('%',#{deptName},'%')</if>
        <if test="userName != null and userName != ''">AND u.user_name LIKE concat('%',#{userName},'%')</if>
        <if test="nickName != null and nickName != ''">AND u.nick_name LIKE concat('%',#{nickName},'%')</if>
        <if test="email != null and email != ''">AND u.email LIKE concat('%',#{email},'%')</if>
        <if test="phonenumber != null and phonenumber != ''">AND u.phonenumber LIKE concat('%',#{phonenumber},'%')</if>
        <if test="sex != null and sex != ''">AND u.sex=#{sex}</if>
        ${params.dataScope}
        ORDER BY u.user_id
    </select>
</mapper>
