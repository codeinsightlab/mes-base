#!/bin/sh
# Stable tool launcher. Inherited user JAVA_HOME/PATH and ordinary Maven configuration.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
JAR="$ROOT/target/mes-base-0.1.0-SNAPSHOT.jar"
FORMAT_JAVA=true
for arg in "$@"; do
  case "$arg" in
    --format-java|--format-java=true) FORMAT_JAVA=false ;;
  esac
  if [ "$arg" = "--help" ]; then
    printf '%s\n' 'mes-codegen --table TABLE [--module MODULE] --business-name NAME [--scope GLOBAL|FACTORY_SCOPED] [--datasource PROFILE] [--schema SCHEMA] [--backend-module MODULE_PATH] [--package PACKAGE] [--author AUTHOR] [--dry-run] [--overwrite] [--output BACKEND_ROOT] [--frontend-root FRONTEND_ROOT] [--config PATH]'
    exit 0
  fi
done
cd "$ROOT"
if [ ! -f "$JAR" ] || [ -n "$(find mes-*/src/main pom.xml mes-*/pom.xml -type f -newer "$JAR" -print -quit)" ]; then
  mvn -B -ntp -DskipTests package >&2
fi
if [ "$FORMAT_JAVA" = true ]; then set -- "$@" --format-java; fi
if [ -n "${JAVA_HOME:-}" ]; then JAVA_BIN="$JAVA_HOME/bin/java"; else JAVA_BIN=java; fi
if [ -n "${MES_CODEGEN_DRIVER_CLASSPATH:-}" ]; then
  exec "$JAVA_BIN" -Dloader.main=dev.mesbase.platform.codegen.CodegenCli "-Dloader.path=$MES_CODEGEN_DRIVER_CLASSPATH" -cp "$JAR" org.springframework.boot.loader.launch.PropertiesLauncher "$@"
else
  exec "$JAVA_BIN" -Dloader.main=dev.mesbase.platform.codegen.CodegenCli -cp "$JAR" org.springframework.boot.loader.launch.PropertiesLauncher "$@"
fi
