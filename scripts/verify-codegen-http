#!/usr/bin/python3
"""TEST ONLY real generated Controller acceptance; requires explicit disposable fixture server."""
import argparse,json,os,urllib.request,urllib.error
parser=argparse.ArgumentParser();parser.add_argument('--test-only',action='store_true',required=True);parser.add_argument('--port',type=int,required=True);args=parser.parse_args()
if not 1<=args.port<=65535:raise SystemExit('Invalid loopback port')
password=os.environ.get('MES_TEST_ONLY_PASSWORD')
if not password:raise SystemExit('Explicit synthetic MES_TEST_ONLY_PASSWORD required')
base='http://127.0.0.1:'+str(args.port);passed=0
def call(path,method='GET',body=None,token=None,factory=None,expected=200):
 global passed
 headers={}
 if token:headers['Authorization']='Bearer '+token
 if factory:headers['X-Factory-Id']=factory
 data=None if body is None else json.dumps(body).encode()
 if data:headers['Content-Type']='application/json'
 request=urllib.request.Request(base+path,data=data,headers=headers,method=method)
 try:response=urllib.request.urlopen(request,timeout=10)
 except urllib.error.HTTPError as e:response=e
 with response:
  assert response.status==expected,(path,response.status,expected)
  content=response.read();value=json.loads(content) if content else None
  assert response.headers.get('X-Request-Id'),path
  if expected>=400:assert set(value)=={'errorCode','message','requestId'}
  passed+=1;return value
reader=call('/api/platform/session','POST',{'username':'test-reader','password':password})['accessToken']
options=call('/api/foundation/factories?limit=100',token=reader)
assert all(f['name'].startswith('TEST ONLY') for f in options) and {f['factoryId'] for f in options}=={'A','B'},'Not the owned TEST ONLY fixture'
path='/api/testonly/gen-demo-config'
call(path,expected=401);call(path,token=reader,expected=400);call(path,token=reader,factory='B',expected=403)
call(path+'?limit=101',token=reader,factory='A',expected=400)
page=call(path+'?limit=20',token=reader,factory='A');assert len(page['items'])==page['total']==2 and all(r['factoryId']=='A' for r in page['items'])
body={'code':'TEST-HTTP-ONLY','name':'TEST ONLY HTTP','status':1,'quantity':'12345678901234.1234','effectiveAt':None,'remark':None}
call(path,'POST',{**body,'factoryId':'B'},reader,'A',400)
row=call(path,'POST',body,reader,'A');assert row['factoryId']=='A' and row['quantity']==body['quantity']
id=row['id'];assert isinstance(id,str)
call(path+'/'+id,token=reader,factory='A')
call(path+'/999',token=reader,factory='A',expected=404)
call(path+'/999','PUT',body,reader,'A',404);call(path+'/999','DELETE',None,reader,'A',404)
changed=call(path+'/'+id,'PUT',{**body,'name':'TEST ONLY HTTP updated'},reader,'A');assert changed['name'].endswith('updated')
call(path+'/'+id,'DELETE',None,reader,'A',204);call(path+'/'+id,token=reader,factory='A',expected=404)
admin=call('/api/platform/session','POST',{'username':'test-admin','password':password})['accessToken']
call(path,token=admin,factory='A',expected=403)
call('/api/platform/session','DELETE',token=reader,expected=204);call(path,token=reader,factory='A',expected=401)
call('/api/platform/session','DELETE',token=admin,expected=204)
print(json.dumps({'testOnly':True,'passed':passed,'failed':0,'boundary':'loopback synthetic H2; real generated Controller + Platform authentication'},ensure_ascii=False))
