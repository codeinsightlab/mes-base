#!/usr/bin/python3
"""TEST ONLY: one CLI -> correct repos -> backend compile -> Vue build/tests. Optional loopback UI server.
No production profile/credentials are inherited; metadata fixture contains no business rows until serve.
"""
import argparse,json,os,pathlib,shutil,subprocess,tempfile
ROOT=pathlib.Path(__file__).resolve().parent.parent
UI=ROOT.with_name('mes-base-ui')
parser=argparse.ArgumentParser();parser.add_argument('--serve',action='store_true');args=parser.parse_args()
java_home=os.environ.get('JAVA_HOME');java=str(pathlib.Path(java_home)/'bin/java') if java_home else 'java';javac=str(pathlib.Path(java_home)/'bin/javac') if java_home else 'javac'
def run(command,**kwargs):return subprocess.run(command,check=True,**kwargs)
run(['mvn','-B','-ntp','-DskipTests','package','dependency:build-classpath','-Dmdep.includeScope=test','-Dmdep.outputFile=target/codegen-fixture-classpath.txt'],cwd=ROOT)
cp=os.pathsep.join([str(ROOT/'target/test-classes'),str(ROOT/'target/classes'),(ROOT/'target/codegen-fixture-classpath.txt').read_text().strip()])
backend=ROOT/'target/codegen-acceptance/backend';frontend=UI/'target/codegen-acceptance/frontend';classes=ROOT/'target/codegen-acceptance/classes'
for directory in [backend,frontend,classes]:
 if directory.exists():shutil.rmtree(directory) # Only this script's explicitly-owned ignored acceptance outputs.
 directory.mkdir(parents=True)
with tempfile.TemporaryDirectory(prefix='mes-test-only-',dir='/private/tmp') as temp:
 temp=pathlib.Path(temp);database=temp/'business';h2jar=run([java,'-cp',cp,'dev.mesbase.TestOnlyCodegenFixture','--test-only','prepare',str(database)],cwd=ROOT,capture_output=True,text=True).stdout.strip().splitlines()[-1]
 env={k:v for k,v in os.environ.items() if not k.startswith(('MES_','SPRING_')) and k not in ('JAVA_TOOL_OPTIONS','JDK_JAVA_OPTIONS','_JAVA_OPTIONS')}
 env.update(MES_CODEGEN_URL='jdbc:h2:file:'+str(database),MES_CODEGEN_USER='sa',MES_CODEGEN_PASSWORD='',MES_CODEGEN_DEFAULT_DATASOURCE='dev',MES_CODEGEN_DRIVER_CLASSPATH=h2jar,SPRING_CONFIG_LOCATION='classpath:/application.properties')
 command=[str(ROOT/'scripts/mes-codegen'),'--table=gen_demo_config','--module=testonly','--business-name=合成配置（TEST ONLY）','--scope=FACTORY_SCOPED','--package=dev.mesbase.modules.testonly','--output='+str(backend),'--frontend-root='+str(frontend)]
 dry=run(command+['--dry-run'],cwd=ROOT,env=env,capture_output=True,text=True);manifest=json.loads(dry.stdout);assert manifest['status']=='DRY_RUN';assert not list(backend.rglob('*.java'));assert not list(frontend.rglob('*.vue'))
 emitted=run(command,cwd=ROOT,env=env,capture_output=True,text=True);manifest=json.loads(emitted.stdout);assert manifest['status']=='GENERATED';assert len(manifest['files'])==16
 validation=ROOT/'target/validation';validation.mkdir(exist_ok=True);(validation/'codegen-cli-manifest.json').write_text(emitted.stdout)
 # Agent postprocessing of the synthetic module: reviewed enum semantics, Chinese labels, nullable remark textarea.
 pkg=backend/'src/main/java/dev/mesbase/modules/testonly';enum=pkg/'GenDemoConfigStatus.java';enum.write_text('package dev.mesbase.modules.testonly;\n/** TEST ONLY synthetic fixture enum. */\npublic enum GenDemoConfigStatus { DISABLED(0,"停用"), ENABLED(1,"启用");private final int code;private final String name;GenDemoConfigStatus(int code,String name){this.code=code;this.name=name;}public int getCode(){return code;}public String getName(){return name;}public static GenDemoConfigStatus fromCode(Integer code){for(var value:values())if(code!=null&&value.code==code)return value;throw new dev.mesbase.core.error.FoundationException(dev.mesbase.core.error.ErrorCode.BAD_REQUEST);} }\n')
 impl=pkg/'GenDemoConfigServiceImpl.java';impl.write_text(impl.read_text().replace('var row=new GenDemoConfigEntity();','GenDemoConfigStatus.fromCode(in.status());var row=new GenDemoConfigEntity();'))
 view=frontend/'src/views/testonly/genDemoConfig/index.vue';s=view.read_text();s=s.replace("label: '状态', kind: 'number'","label: '状态', options: [{label: '启用', value: 1, tone: 'success'}, {label: '停用', value: 0, tone: 'info'}], kind: 'number'");s=s.replace("label: '备注', kind: 'text'","label: '备注', kind: 'textarea'");view.write_text(s)
 sources=list((backend/'src/main/java').rglob('*.java'))+list((backend/'src/test/java').rglob('*.java'))
 run([javac,'-parameters','-cp',cp,'-d',str(classes)]+[str(p) for p in sources],cwd=ROOT)
 resources=backend/'src/main/resources'
 for p in resources.rglob('*'):
  if p.is_file():dest=classes/p.relative_to(resources);dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 (frontend/'index.html').write_text('<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TEST ONLY Codegen 验收</title></head><body><div id="app"></div><script type="module" src="/main.ts"></script></body></html>')
 (frontend/'main.ts').write_text("import {createApp,h} from 'vue';import {createPinia} from 'pinia';import {createRouter,createWebHistory} from 'vue-router';import ElementPlus from 'element-plus';import zhCn from 'element-plus/es/locale/lang/zh-cn';import 'element-plus/dist/index.css';import '@/styles.css';import App from '@/App.vue';import Home from '@/views/Home.vue';import Login from '@/views/Login.vue';import Platform from '@/views/PlatformPage.vue';import Files from '@/views/Files.vue';import Demo from './src/views/testonly/genDemoConfig/index.vue';import {useAuth} from '@/stores/auth';import {configureRequests} from '@/lib/request';const router=createRouter({history:createWebHistory(),routes:[{path:'/login',component:Login},{path:'/',component:Home},{path:'/demo',component:Demo},{path:'/files',component:Files},{path:'/platform/:resource',component:Platform}]});const pinia=createPinia(),auth=useAuth(pinia);configureRequests(()=>({token:auth.token,factoryId:auth.factoryId,revision:auth.revision}),()=>auth.clear());router.beforeEach(to=>to.path!='/login'&&!auth.loggedIn?'/login':true);createApp({render:()=>h('div',[h('div',{style:'background:#fff3cf;color:#725000;text-align:center;padding:7px;font-size:12px'},'TEST ONLY — 合成数据，不是 MES 业务模块'),h(App)])}).use(pinia).use(router).use(ElementPlus,{locale:zhCn}).mount('#app');")
 config=frontend/'vite.config.ts';config.write_text("import {defineConfig} from 'vite';import vue from '@vitejs/plugin-vue';export default defineConfig({root:"+json.dumps(str(frontend))+",plugins:[vue()],resolve:{alias:[{find:'@/api/testonly',replacement:"+json.dumps(str(frontend/'src/api/testonly'))+"},{find:'@',replacement:"+json.dumps(str(UI/'src'))+"}]},server:{fs:{allow:["+json.dumps(str(UI))+" ]},proxy:{'/api':{target:process.env.MES_TEST_ONLY_BACKEND},'/health':{target:process.env.MES_TEST_ONLY_BACKEND}}}});" )
 # Type-check generated TS/SFC as well as the real shared Base UI.
 tsconfig=frontend/'tsconfig.json';tsconfig.write_text(json.dumps({'extends':str(UI/'tsconfig.json'),'compilerOptions':{'baseUrl':str(UI),'paths':{'@/api/testonly/*':[str(frontend/'src/api/testonly/*')],'@/*':['src/*']}},'include':[str(frontend/'src/**/*.ts'),str(frontend/'src/**/*.vue'),str(UI/'src/**/*.ts'),str(UI/'src/**/*.vue')]}))
 run(['node',str(UI/'node_modules/vue-tsc/bin/vue-tsc.js'),'--noEmit','-p',str(tsconfig)],cwd=UI)
 run(['node',str(UI/'node_modules/vite/bin/vite.js'),'build','--config',str(config)],cwd=UI)
 print('TEST ONLY CLI default profile, dry-run, 16 artifacts, correct placement, backend javac and generated Vue build: PASSED',flush=True)
 if args.serve:
  if not os.environ.get('MES_TEST_ONLY_PASSWORD'):raise SystemExit('Set an explicit synthetic MES_TEST_ONLY_PASSWORD for --serve')
  environment=env.copy();environment['MES_TEST_ONLY_PASSWORD']=os.environ['MES_TEST_ONLY_PASSWORD'];run([java,'-cp',str(classes)+os.pathsep+cp,'dev.mesbase.TestOnlyCodegenFixture','--test-only','serve',str(database)],cwd=ROOT,env=environment)
