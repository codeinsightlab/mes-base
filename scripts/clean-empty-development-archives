#!/usr/bin/python3
"""Remove empty migration archives only from explicitly owned development/test schemas."""
import argparse
from pathlib import Path
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--mysql-config', type=Path, required=True)
parser.add_argument('--database', choices=('mes_base_dev', 'mes_base_prod'), default='mes_base_dev')
args = parser.parse_args()
command = ['mysql', '--defaults-extra-file=' + str(args.mysql_config.resolve()),
           '--database=' + args.database, '--batch', '--skip-column-names']

def query(sql):
    result = subprocess.run(command, input=sql, capture_output=True, text=True)
    if result.returncode:
        raise SystemExit('Development archive cleanup failed; database diagnostics suppressed.')
    return result.stdout.strip()

archives = ['phase1_legacy_sys_' + name for name in (
    'user', 'role', 'menu', 'dict_type', 'dict_data', 'config', 'job', 'oper_log',
    'logininfor', 'job_log', 'file', 'session', 'user_role', 'role_menu')]
archives += ['phase1_archived_private_file', 'phase1_archived_sys_session']
existing = set(query("SELECT TABLE_NAME FROM information_schema.TABLES "
                     "WHERE TABLE_SCHEMA='" + args.database + "'").splitlines())
tables = [table for table in archives if table in existing]
# Inspect all candidates before any DDL. Populated migration history must remain recoverable.
for table in tables:
    if query('SELECT COUNT(*) FROM `' + table + '`') != '0':
        raise SystemExit('Refusing to delete populated migration archive: ' + table)
if tables:
    query('SET FOREIGN_KEY_CHECKS=0; DROP TABLE ' +
          ','.join('`' + table + '`' for table in tables) + '; SET FOREIGN_KEY_CHECKS=1;')
print('Removed ' + str(len(tables)) + ' empty migration archive tables from ' + args.database + '.')
